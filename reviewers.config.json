{
  "effort": "high",
  "minConfidence": 0.6,
  "minConfidenceCritical": 0.4,
  "maxComments": 15,
  "minSeverity": "minor",
  "requestChangesOnCritical": false,
  "maxFiles": 60,
  "sonar": {
    "enabled": true,
    "projectKey": "",
    "scans": ["code", "secrets", "dependencies"],
    "depth": "DEEP",
    "timeoutMs": 600000
  },
  "ignore": [
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/*.snap",
    "**/*.min.js",
    "**/*.svg",
    "dist/**",
    "build/**",
    "**/__generated__/**"
  ]
}
